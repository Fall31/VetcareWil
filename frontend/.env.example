# ========================================
# ARCHIVO DE CONFIGURACIÓN - FRONTEND
# ========================================
# Copia este archivo a: frontend/.env.local
# Luego reemplaza los valores con tus credenciales de Supabase

# URL del proyecto Supabase (obtener de Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Clave pública del frontend (obtener de Settings > API > anon public)
# Esta clave es segura para publicar en Git - Supabase la valida con RLS
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
