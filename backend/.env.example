# ========================================
# ARCHIVO DE CONFIGURACIÓN - BACKEND
# ========================================
# Copia este archivo a: backend/.env
# Luego reemplaza los valores con tus credenciales de Supabase

# URL del proyecto Supabase (obtener de Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Clave de servicio del backend (obtener de Settings > API > service_role secret)
# ⚠️ IMPORTANTE: Esta es una clave PRIVADA - NO exponerla en Git ni publicar
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# Ambiente
NODE_ENV=development

# Usar datos mock en lugar de Supabase (útil para pruebas sin base de datos)
# USE_MOCK=false
